# 带内容哈希的静态资源：文件名变了 URL 就变，可以放心永久缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 图片：内容更新频率极低，长缓存 + 允许浏览器陈旧期间后台校验
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# HTML 与 RSS：永远走校验（ETag），保证发布后立刻可见。
# 注意不能用 /* 兜底——它会和 /_astro/* 同时命中并拼出双 max-age，
# 所以这里枚举所有 HTML 页面路径（与 _astro 不重叠）
/
/rss.xml
/search.json
/404.html
/about
/about/
/archive
/archive/
/blog
/blog/
/blog/*
/categories
/categories/
/categories/*
/tags
/tags/
/tags/*
/friends
/guestbook
  Cache-Control: public, max-age=0, must-revalidate
