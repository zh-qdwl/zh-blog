---
import { SITE_TITLE, HERO_IMAGE, HERO_FOCUS, HERO_TAGLINES } from '../consts';

// 首句直接渲染进 HTML：无 JS、爬虫抓取、首帧渲染都能看到文案。
// 下面的打字机脚本只是「接管」这段文字，而不是「产生」它。
const firstLine = HERO_TAGLINES[0] ?? '';
---

<section class="hero">
  <!-- alt 留空：这是装饰图，站名已经作为 h1 存在，读屏不该再念一遍 -->
  <img
    class="hero-img"
    src={HERO_IMAGE}
    alt=""
    width="1920"
    height="1080"
    fetchpriority="high"
    decoding="async"
    style={`object-position:${HERO_FOCUS}`}
  />
  <div class="hero-scrim"></div>

  <div class="hero-body">
    <!-- 站名不在整屏上露出，但必须留在文档里：
         去掉它首页就一个 h1 都没有了（.section-title 是 <p>，文章卡是 <h3>），
         标题层级断裂，读屏用户也失去了「这是哪个站」的第一句话。 -->
    <h1 class="sr-only">{SITE_TITLE}</h1>
    <p class="hero-type"><span
        class="hero-type-text"
        data-taglines={JSON.stringify(HERO_TAGLINES)}>{firstLine}</span><span
        class="hero-caret"
        aria-hidden="true"></span></p>
  </div>

  <a class="hero-down" href="#content" aria-label="向下滚动，查看文章">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    /* 100vh 在移动端会随地址栏收放而跳动；svh 取的是「小视口」高度，稳定。
       两条都写：不支持 svh 的浏览器落回 vh。 */
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--hero-ink);
    /* 底图加载完成前的兜底底色。它必须跟 --hero-ink 同向（暗底配白字 / 浅底配深字），
       所以也做成令牌随 HERO_TONE 一起切，写死深色会让浅色模式的首帧读不出字。 */
    background: var(--hero-fallback);
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    /* 盖掉 base.css 里 img { height: auto } 的全局重置 */
    height: 100%;
    object-fit: cover;
    /* object-position 由 HERO_FOCUS 内联写入 */
  }

  /* 遮罩只剩上下两条边带，各罩一处必须可读的元素：
       ① 顶部实心带 —— 透明导航（高 60px，这里留到 72px，整条导航都在满 α 区内）
       ② 底部实心带 —— 向下箭头
     每条都是「先走一段实心、再开始渐隐」。若直接从 α 渐隐到 0，
     元素所在位置拿到的就是衰减后的 α，tokens.test.ts 保证的那条对比度也就不成立了。

     中央原本还有第三层椭圆罩着打字机文案，已去掉——它在浅色平涂底图上会洗出
     一块边界分明的亮斑。文案改用每个字自带的实色描边，做法见下面的 .hero-type。 */
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, var(--hero-scrim) 0, var(--hero-scrim) 72px, transparent 200px),
      linear-gradient(0deg, var(--hero-scrim) 0, var(--hero-scrim) 72px, transparent 220px);
  }

  .hero-body {
    position: relative;
    z-index: 1;
    max-width: 900px;
    padding: 0 24px;
    text-align: center;
    /* fade-up 定义在 motion.css，是全站共用的入场语言 */
    animation: fade-up 0.7s var(--ease) both;
  }

  /* 注意这里没有 .hero h1 的样式：站名是 .sr-only，给它写 margin/font-size
     反而会赢过 .sr-only 的 margin:-1px（.hero h1 比 .sr-only 多一层选择器），
     在文案上方顶出一段空白。要让站名重新可见，删掉 h1 的 sr-only 类再补样式。 */

  /* 中央遮罩去掉后文字直接压在底图上，可读性改由每个字自带的一圈描边保证。
     前 8 条 text-shadow 是 0 模糊、1px 八向偏移——叠起来就是一圈**不透明**的实色描边，
     字形边缘拿到的底色因此恒等于 --hero-halo，与 --hero-ink 的对比度可以断言
     （tokens.test.ts 守着），而不是又一处"浏览器合成出来、令牌系统看不见"的颜色。
     最后一条 14px 模糊只负责柔化外缘，让它像光晕而不是贴纸，不承担对比度职责。

     为什么不回到整块遮罩：描边贴着字形走，在浅色平涂底图上不会糊出一块方块——
     那正是中央椭圆被拿掉的原因。 */
  .hero-type {
    margin: 0;
    /* 句子长短不一，固定高度，避免换句时把整块文字顶来顶去。
       1.8em 只够一行——窄屏另有一条两行的规则，见下方媒体查询。 */
    min-height: 1.8em;
    font-size: clamp(1.25rem, 2.8vw, 2.1rem);
    /* 字重从 300 提到 500：细笔画压在满是黑描边的画面上，字形会被吃掉。
       空灵感改由字距和光晕承担，而不是靠把笔画调细或把颜色调淡——
       后者一淡对比度就掉，而这里已经没有整块遮罩兜底了。 */
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--hero-ink);
    text-shadow:
      1px 0 0 var(--hero-halo),
      -1px 0 0 var(--hero-halo),
      0 1px 0 var(--hero-halo),
      0 -1px 0 var(--hero-halo),
      1px 1px 0 var(--hero-halo),
      -1px -1px 0 var(--hero-halo),
      1px -1px 0 var(--hero-halo),
      -1px 1px 0 var(--hero-halo),
      0 0 14px var(--hero-halo);
  }

  .hero-caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 3px;
    vertical-align: -0.16em;
    background: currentColor;
    /* 光标是背景色画的，text-shadow 对背景无效，得用 box-shadow 补同一圈描边，
       否则它会是整行里唯一没有光晕、压在底图上看不清的元素 */
    box-shadow: 0 0 0 1px var(--hero-halo), 0 0 14px var(--hero-halo);
    animation: hero-blink 1s steps(2, start) infinite;
  }

  .hero-down {
    position: absolute;
    left: 50%;
    bottom: 26px;
    z-index: 1;
    display: inline-flex;
    padding: 6px;
    border-radius: 999px;
    color: var(--hero-ink);
    animation: hero-bob 2.2s var(--ease) infinite;
  }
  .hero-down:hover {
    text-decoration: none;
  }

  @keyframes hero-blink {
    50% {
      opacity: 0;
    }
  }

  /* 用 translate 而非 transform 做水平居中 + 上下浮动：
     和 motion.css 里那条注释同源——transform 是高优先级合成属性，
     这里两者都归到 translate 一个属性上，写法也更直白。 */
  @keyframes hero-bob {
    0%,
    100% {
      translate: -50% 0;
    }
    50% {
      translate: -50% 7px;
    }
  }
  .hero-down {
    translate: -50% 0;
  }

  @media (max-width: 640px) {
    /* 不撑满整屏：底部露出一线内容，暗示「下面还有东西」 */
    .hero {
      height: 88vh;
      height: 88svh;
    }
    /* 窄屏放不下一行：字号变大又拉了字距，中文那两句必然折到第二行。
       这里直接按两行预留高度，折行就不会在打字过程中把整块文字顶动。
       只有一行时底部多出的空白由 .hero-body 的居中对齐吸收，几乎看不出来。
       注意 em 是相对 font-size 的，字号改了这里不用跟着算。 */
    .hero-type {
      min-height: 3.6em;
      /* 字距在窄屏上会明显吃掉可用宽度，收一档 */
      letter-spacing: 0.08em;
    }
    /* 中央椭圆去掉后，窄屏的遮罩和桌面完全一致，不再需要单独一套 */
  }
</style>

<script>
  // 打字机。首句已由服务端渲染，这里只负责「删掉再打下一句」的循环。
  const el = document.querySelector<HTMLElement>('.hero-type-text');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 关动效时直接不启动：静态停在首句即可，不做任何 DOM 变更
  if (el && !reduced) {
    const lines: string[] = JSON.parse(el.dataset.taglines || '[]');
    // 只有一句就没有可循环的对象，留着静态显示
    if (lines.length > 1) {
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      (async () => {
        let i = 0;
        // 首句让它先停一会儿再删，否则一进页面文字就开始消失，像是加载失败
        await sleep(2200);
        while (true) {
          const cur = lines[i];
          for (let n = cur.length; n >= 0; n--) {
            el.textContent = cur.slice(0, n);
            await sleep(38);
          }
          i = (i + 1) % lines.length;
          const next = lines[i];
          for (let n = 1; n <= next.length; n++) {
            el.textContent = next.slice(0, n);
            await sleep(88);
          }
          await sleep(2200);
        }
      })();
    }
  }
</script>
