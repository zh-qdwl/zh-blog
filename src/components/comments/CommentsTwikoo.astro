---
import NoScriptNotice from './NoScriptNotice.astro';

interface Props {
  config: { envId: string; region: string };
  /** 评论线路径键，由 Comments.astro 用 normalizeCommentPath 算出 */
  path: string;
  lazy: boolean;
}
const { config, path, lazy } = Astro.props;

// 版本写死，不用 @latest。latest 会在某天静默换掉 DOM 结构，
// 而 comments.css 里那组 .tk-* / .el-* 覆盖是绑着结构的，会一起碎掉。
// 那组选择器已经对着 1.7.19 的产物逐个核过（内嵌的 element-ui 样式表 +
// Vue render 函数里的 staticClass），所以钉版本不只是防御性的：
// 它是那份核对结果成立的前提。升级时改这一行，然后回去重做一遍核对。
const TWIKOO_VERSION = '1.7.19';
const cdn = `https://cdn.jsdelivr.net/npm/twikoo@${TWIKOO_VERSION}/dist/twikoo.min.js`;
---

<section id="comments" class="comments" aria-label="评论">
  <div id="twikoo-mount" class="comments-mount"></div>
  <NoScriptNotice />
</section>

<script is:inline define:vars={{ cdn, envId: config.envId, region: config.region, path, lazy }}>
  (function () {
    const host = document.getElementById('twikoo-mount');
    if (!host) return;

    let loaded = false;
    // 加载指示器：懒加载那几秒原本是纯空白，这里用一个点阵动画填上。
    // 脚本加载失败/超时也会移除，不能让占位一直挂着。
    let loader = null;
    let loaderTimer = 0;
    let loaderShownAt = 0;

    function showLoader() {
      if (loader || !window.__createDotLoader) return;
      try {
        loader = window.__createDotLoader(host);
        loaderShownAt = Date.now();
      } catch (e) {
        // 指示器只是装饰，坏了不影响评论本身
        loader = null;
        return;
      }
      // 15 秒兜底：网络异常时别让点阵一直转
      loaderTimer = window.setTimeout(hideLoader, 15000);
    }

    function hideLoader() {
      window.clearTimeout(loaderTimer);
      loaderTimer = 0;
      if (!loader) return;
      // 至少显示 600ms，否则评论加载很快时点阵只是一闪，
      // 反而像页面闪了一下，比不显示还糟。
      const elapsed = Date.now() - loaderShownAt;
      const wait = Math.max(0, 600 - elapsed);
      const done = () => {
        if (loader) {
          loader.destroy();
          loader = null;
        }
      };
      if (wait) window.setTimeout(done, wait);
      else done();
    }

    function load() {
      if (loaded) return;
      loaded = true;
      showLoader();
      const s = document.createElement('script');
      s.src = cdn;
      s.onload = function () {
        const opts = {
          envId: envId,
          el: '#twikoo-mount',
          // path 由构建期算出，不用 location.pathname——后者带不带尾斜杠取决于
          // 访客怎么进来，而 Twikoo 把两种形态当成两条独立评论线。
          path: path,
          lang: 'zh-CN',
        };
        // region 只有腾讯云要填。给 Vercel / Cloudflare 传空串会让它去连一个
        // 不存在的地域，所以留空时干脆不传这个键。
        if (region) opts.region = region;
        window.twikoo.init(opts);
        // 不等 init 的返回值（不同版本返回 Promise 或 undefined），
        // 直接盯 DOM：评论真正渲染出来（有 .tk-comments 或任何子节点）就收起点阵。
        var stopWatch = function () {
          hideLoader();
          if (watcher) watcher.disconnect();
          if (initTimer) clearTimeout(initTimer);
        };
        var watcher = new MutationObserver(function () {
          if (host.querySelector('.tk-comments, .tk-comment, .tk-submit')) stopWatch();
        });
        watcher.observe(host, { childList: true, subtree: true });
        // 评论数为 0 时 Twikoo 也会渲染提示，用超时兜底；总比一直转好
        var initTimer = setTimeout(stopWatch, 4000);
        // 带 #评论id 打开页面时，评论区是懒加载 + 异步渲染的：浏览器解析
        // hash 时锚点元素还不存在，原生跳转不会发生。init 完成后用
        // MutationObserver 等那条评论真正渲染出来，再手动滚过去。
        // 10 秒后放弃——评论加载失败或 hash 指向不存在的评论时不无限等。
        if (location.hash && /^[0-9a-f]{32}$/.test(location.hash.slice(1))) {
          var targetId = location.hash.slice(1);
          var tryScroll = function () {
            var el = document.getElementById(targetId);
            if (el) {
              el.scrollIntoView({ block: 'center' });
              observer.disconnect();
              return true;
            }
            return false;
          };
          var observer = new MutationObserver(function () { tryScroll(); });
          observer.observe(document.body, { childList: true, subtree: true });
          // 轮询兜底：某些渲染路径不产生 childList 变化
          var poll = setInterval(function () { if (tryScroll()) clearInterval(poll); }, 300);
          setTimeout(function () { observer.disconnect(); clearInterval(poll); }, 10000);
        }
      };
      document.head.appendChild(s);
    }

    if (lazy && window.__commentsWhenNear) window.__commentsWhenNear(host, load);
    else load();
  })();
</script>
