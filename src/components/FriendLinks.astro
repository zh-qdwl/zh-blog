---
// 友链卡片网格。抽成组件的原因：关于页和 /friends 页都要用它，
// 两处各写一遍样式必然会随时间跑偏（改一处忘另一处）。
import { FRIEND_LINKS, type FriendLink } from '../consts';

interface Props {
  /** 覆盖默认数据源，便于将来分页或筛选 */
  links?: FriendLink[];
}

const { links = FRIEND_LINKS } = Astro.props;

// 名字哈希取色相：没配头像时用首字母圆形占位，颜色由名字决定，
// 同一个站点每次刷新都是同一个颜色。与 PostCard 的色相方案同源。
function hueFor(name: string): number {
  let h = 0;
  for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) % 360;
  return h;
}
---

{links.length > 0 && (
  <ul class="friend-list">
    {links.map((f) => (
      <li class="friend-card">
        <a href={f.href} target="_blank" rel="noopener">
          {f.avatar ? (
            <img
              class="avatar"
              src={f.avatar}
              alt={`${f.name}的头像`}
              width="56"
              height="56"
              loading="lazy"
            />
          ) : (
            <span
              class="avatar avatar-fallback"
              style={`--hue:${hueFor(f.name)}`}
              aria-hidden="true"
            >{f.name.slice(0, 1)}</span>
          )}
          <span class="info">
            <span class="name">{f.name}</span>
            <span class="desc">{f.desc}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .friend-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
  }
  .friend-card a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-card, var(--bg));
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .friend-card a:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
    box-shadow: var(--shadow, 0 4px 14px rgb(0 0 0 / 0.06));
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .avatar-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.2rem;
    color: hsl(var(--hue) 60% 42%);
    background: hsl(var(--hue) 70% 92%);
  }
  :global([data-theme='dark']) .avatar-fallback {
    color: hsl(var(--hue) 60% 78%);
    background: hsl(var(--hue) 40% 22%);
  }
  .info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    font-weight: 600;
  }
  .desc {
    color: var(--text-soft);
    font-size: 0.85rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
