---
// 右下角悬浮按钮组：返回顶部 + 直达评论（参考 Teek 主题右下按钮组的视觉）。
// 返回顶部外圈带滚动进度环（conic-gradient + mask 圆环，滚动越深环越满）。
// 仅文章页使用；评论区懒加载，滚动到锚点时由 IntersectionObserver 自然触发。
---
<div id="floating-actions" class="floating-actions" hidden>
  <button class="fa-btn fa-top" id="fa-top" title="返回顶部" aria-label="返回顶部" style="--fa-progress: 0">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
  </button>
  <button class="fa-btn" id="fa-comments" title="直达评论" aria-label="直达评论">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
  </button>
</div>

<script>
  const box = document.getElementById('floating-actions')!;
  const topBtn = document.getElementById('fa-top')!;

  // 进度环 + 显隐一起算：滚过 0.8 屏才出现
  function update() {
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const progress = scrollable > 0 ? Math.min(100, (window.scrollY / scrollable) * 100) : 0;
    topBtn.style.setProperty('--fa-progress', progress.toFixed(1));
    box.hidden = window.scrollY <= window.innerHeight * 0.8;
  }
  window.addEventListener('scroll', update, { passive: true });
  update();

  topBtn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // 无评论区的页面（关于/友链等）不显示评论按钮
  const commentsBtn = document.getElementById('fa-comments')!;
  const commentsTarget = document.getElementById('comments');
  if (!commentsTarget) commentsBtn.style.display = 'none';
  commentsBtn.addEventListener('click', () => {
    commentsTarget?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  .floating-actions {
    position: fixed;
    right: 28px;
    bottom: 44px;
    z-index: 80;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .floating-actions[hidden] {
    display: none;
  }
  .fa-btn {
    position: relative;
    width: 37px;
    height: 37px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: var(--card);
    color: var(--text-soft);
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: all 0.2s ease;
  }
  /* hover：主题色实底 + 发光 + 图标变白（Teek 同款反馈） */
  .fa-btn:hover {
    background: var(--brand);
    color: var(--brand-ink);
    box-shadow: 0 0 15px var(--brand-soft);
    transform: translateY(-2px);
  }
  /* 返回顶部的滚动进度环：conic-gradient 按滚动比例填充，
     mask 挖成 3.5px 圆环叠在按钮外沿 */
  .fa-top::before {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background:
      radial-gradient(farthest-side, var(--brand) 98%, transparent) top / 3.5px 3.5px no-repeat,
      conic-gradient(var(--brand) calc(var(--fa-progress) * 1%), transparent 0);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(99% - 3.5px), #000 calc(100% - 3.5px));
    mask: radial-gradient(farthest-side, transparent calc(99% - 3.5px), #000 calc(100% - 3.5px));
  }
  @media (max-width: 640px) {
    .floating-actions {
      right: 14px;
      bottom: 18px;
      gap: 10px;
    }
    .fa-btn {
      width: 36px;
      height: 36px;
    }
  }
</style>
