---
import { AUTHOR, AUTHOR_ROLE, AVATAR, SOCIAL } from '../../consts';

// 只渲染填了值的社交链接，留空自动隐藏
const links = [
  { key: 'github', label: 'GitHub', href: SOCIAL.github },
  { key: 'gitee', label: 'Gitee', href: SOCIAL.gitee },
  { key: 'juejin', label: '掘金', href: SOCIAL.juejin },
  { key: 'csdn', label: 'CSDN', href: SOCIAL.csdn },
  { key: 'email', label: 'Email', href: SOCIAL.email ? `mailto:${SOCIAL.email}` : '' },
  { key: 'rss', label: 'RSS', href: SOCIAL.rss },
].filter((l) => l.href);

// 只有真正跳出站外的链接才开新标签页。
// 原本是「除 email 外一律 _blank」，结果同源的 /rss.xml 也会莫名弹出新页。
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<div class="card widget widget-profile">
  <img class="avatar" src={AVATAR} alt={`${AUTHOR}的头像`} width="72" height="72" loading="lazy" />
  <p class="name">{AUTHOR}</p>
  <p class="role">{AUTHOR_ROLE}</p>

  <p class="divider"><span>社交账号</span></p>

  <div class="links">
    {links.map((l) => (
      <a
        href={l.href}
        aria-label={l.label}
        title={l.label}
        target={isExternal(l.href) ? '_blank' : undefined}
        rel={isExternal(l.href) ? 'noopener' : undefined}
      >
        {l.key === 'github' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49v-1.9c-2.78.62-3.37-1.2-3.37-1.2-.46-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.57 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.59.69.49A10.06 10.06 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"></path></svg>
        )}
        {l.key === 'email' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect><path d="M3 6.5l9 6 9-6"></path></svg>
        )}
        {l.key === 'rss' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1.5" fill="currentColor"></circle></svg>
        )}
        {/* Gitee / 掘金 / CSDN 用通用外链图标。
            与其照着记忆画三个品牌 logo（画错比没有更糟），不如用统一的外链符号，
            品牌名交给 aria-label 与 title——读屏和悬停提示都读得到。
            这三个字段在 consts.ts 里默认为空，填了才会出现。 */}
        {(l.key === 'gitee' || l.key === 'juejin' || l.key === 'csdn') && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"></path><path d="M20 4l-8.5 8.5"></path><path d="M19 14v4.5A1.5 1.5 0 0 1 17.5 20h-11A1.5 1.5 0 0 1 5 18.5v-11A1.5 1.5 0 0 1 6.5 6H11"></path></svg>
        )}
      </a>
    ))}
  </div>
</div>

<style>
  .widget-profile {
    padding: 24px 20px;
    text-align: center;
  }
  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 2px solid var(--brand);
    /* 头像是照片而非方形占位图，非正方形的图不该被拉变形 */
    object-fit: cover;
  }
  .name {
    margin: 12px 0 2px;
    font-weight: 700;
    font-size: 1.05rem;
  }
  .role {
    margin: 0;
    color: var(--link);
    font-size: 0.82rem;
  }

  /* 居中带文字的分割线：两侧的线用伪元素撑开，
     不用 <hr> + 绝对定位盖一块底色——那种做法在卡片背景色变化时会露馅。 */
  .divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 18px 0 14px;
    color: var(--text-soft);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-soft);
    transition:
      color var(--dur) var(--ease),
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .links a:hover {
    color: var(--link);
    background: var(--brand-soft);
    border-color: var(--brand);
    transform: translateY(-2px);
    text-decoration: none;
  }
</style>
