---
// 「交换友链」区块。关于页和 /friends 页共用。
//
// 布局演变：最初是左右两栏（我的信息 / 需要你提供）。
// 实际渲染时长 URL 把左栏撑破、文字被裁，而且两栏并排时
// 中间有大量留白，信息密度很低。改为单栏纵向流：
//   说明 → 我的站点信息（多格式可复制）→ 需要你提供什么（折叠）
import FriendInfoCode from './FriendInfoCode.astro';
import { SOCIAL } from '../consts';
---

<section class="friend-apply" aria-labelledby="friend-apply-title">
  <h2 id="friend-apply-title" class="apply-title">交换友链</h2>

  <p class="apply-intro">
    欢迎换链。把你的站点信息发我，我看到会加。下面是本站信息的三种格式，
    挑你建站工具顺手的那种复制就行。
  </p>

  <div class="apply-section">
    <p class="block-label">我的站点信息</p>
    <FriendInfoCode />
  </div>

  <div class="apply-section">
    <details class="apply-details">
      <summary>需要你提供什么</summary>
      <ul class="require-list">
        <li><strong>站点名称</strong>：你的博客叫什么</li>
        <li><strong>站点链接</strong>：https 开头，能正常访问</li>
        <li><strong>头像地址</strong>：正方形图片，建议 100×100 以上</li>
        <li><strong>一句话简介</strong>：20 字以内，说明你写什么</li>
      </ul>
      <p class="note">
        内容以原创技术、生活记录为主；纯采集站、广告站、长期不更新的站点就不加了。
      </p>
      <p class="note">
        联系我：<a href="/guestbook">留言页</a> 或 <a href={`mailto:${SOCIAL.email}?subject=${encodeURIComponent('友链申请')}`}>发邮件</a>。
      </p>
    </details>
  </div>
</section>

<style>
  .friend-apply {
    margin: 40px 0 0;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .apply-title {
    margin: 0 0 12px;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .apply-intro {
    margin: 0 0 22px;
    color: var(--text-soft);
    line-height: 1.75;
  }
  .apply-section {
    margin-bottom: 22px;
  }
  .apply-section:last-child {
    margin-bottom: 0;
  }
  .block-label {
    margin: 0 0 12px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-soft);
  }
  /* 折叠：需要提供的信息默认收起，不占版面。
     一般访客只是想知道"怎么换链"，真打算换的人才展开。 */
  .apply-details {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-soft);
    padding: 0;
  }
  .apply-details summary {
    padding: 13px 16px;
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    user-select: none;
  }
  .apply-details summary::-webkit-details-marker {
    display: none;
  }
  .apply-details summary::before {
    content: '▸';
    color: var(--text-soft);
    font-size: 0.8rem;
    transition: transform 0.2s ease;
  }
  .apply-details[open] summary::before {
    transform: rotate(90deg);
  }
  .apply-details summary:hover {
    color: var(--link);
  }
  .require-list {
    margin: 0;
    padding: 0 16px 0 38px;
    font-size: 0.88rem;
    line-height: 1.9;
  }
  .require-list strong {
    color: var(--text);
  }
  .note {
    margin: 12px 16px 0;
    font-size: 0.82rem;
    color: var(--text-soft);
    line-height: 1.7;
  }
  .apply-details .note:last-child {
    margin-bottom: 16px;
  }
</style>
