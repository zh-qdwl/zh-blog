---
// 左下角 2D 看板娘：刷新（换姿势/重新加载）+ 换装（多个模型轮换），选择存 localStorage。
// live2d 库与模型按需加载，库只加载一次，换模型 = 清容器重新 loadlive2d。
// 注意：loadlive2d 直接对容器元素调 getContext，所以容器必须是 <canvas> 而不是 div。
const MODELS = [
  { id: 'shizuku', label: '雫' },
  { id: 'koharu',  label: '小春' },
  { id: 'miku',    label: '初音' },
  { id: 'z16',     label: 'Z16' },
  { id: 'haruto',  label: '春人' },
  { id: 'tororo',  label: '虎纹' },
  { id: 'izumi',   label: '泉' },
  { id: 'tsumiki', label: '积木' },
  { id: 'nico',    label: 'Nico' },
  { id: 'chitose', label: '千岁' },
];
---
<div id="model-widget" class="model-widget" data-mode="2d">
  <canvas id="live2d-container" class="model-stage" width="300" height="400"></canvas>
  <div class="model-switch" role="group" aria-label="看板娘控制">
    <button class="ms-btn" id="ms-refresh" title="刷新看板娘">↻</button>
    <button class="ms-btn" id="ms-skin" title="换一个模型"><span id="ms-skin-label">换装</span></button>
    <button class="ms-btn" id="ms-toggle" title="显示/隐藏看板娘" data-open="1">–</button>
  </div>
</div>

<script>
  const KEY_MODE = 'kanban-mode';
  const KEY_SKIN = 'kanban-skin';
  const MODELS = ['shizuku', 'koharu', 'miku', 'z16', 'haruto', 'tororo', 'izumi', 'tsumiki', 'nico', 'chitose'];
  const CDN = (m: string) => 'https://cdn.jsdelivr.net/npm/live2d-widget-model-' + m + '@1.0.5/assets/' + m + '.model.json';

  const widget = () => document.getElementById('model-widget');
  const stage = () => document.getElementById('live2d-container') as HTMLCanvasElement | null;
  const skinBtn = () => document.getElementById('ms-skin');

  let currentSkin: string | null = null;
  let skinIndex = 0;

  /* ---------- live2d 加载 ---------- */
  let l2dReady = false;
  let l2dLoading = false;

  function ensureLib(cb: () => void) {
    if (window.loadlive2d) { l2dReady = true; cb(); return; }
    if (l2dLoading) { return; } // onload 后由 mount 逻辑接管
    l2dLoading = true;
    const s = document.createElement('script');
    s.src = 'https://fastly.jsdelivr.net/gh/stevenjoezhang/live2d-widget/live2d.min.js';
    s.onload = () => {
      l2dReady = true;
      l2dLoading = false;
      cb();
    };
    s.onerror = () => {
      l2dLoading = false;
      document.getElementById('ms-refresh')?.classList.remove('is-loading');
    };
    document.head.appendChild(s);
  }

  // 换模型的过渡期，库的旧 mousemove 闭包会读一次已清空的模型数据抛 TypeError（hitTestSimpleCustom）。
  // 新模型挂载后一切正常，属于已知的良性一次性错误，这里精确静默它避免控制台噪音。
  window.addEventListener('error', (ev: ErrorEvent) => {
    const st = (ev.error && ev.error.stack) || '';
    if (st.includes('hitTestSimpleCustom') || st.includes('live2d.min.js')) {
      ev.preventDefault();
    }
  });

  function mount(skin: string) {
    const old = stage();
    if (!old || !window.loadlive2d) return;
    currentSkin = skin;
    skinIndex = Math.max(0, MODELS.indexOf(skin));
    localStorage.setItem(KEY_SKIN, skin);
    const label = document.getElementById('ms-skin-label');
    if (label) label.textContent = skin === 'shizuku' ? '换装' : skin;
    // 换模型：整体替换 canvas 元素。旧模型的内部动画循环持有旧元素引用，
    // 替换后旧循环自然作废，避免过渡期 hitTest 读到已清空的模型数据而抛错。
    const fresh = document.createElement('canvas');
    fresh.id = 'live2d-container';
    fresh.className = 'model-stage is-visible';
    fresh.width = 300;
    fresh.height = 400;
    old.replaceWith(fresh);
    window.loadlive2d('live2d-container', CDN(skin));
  }

  function setLoading(on: boolean) {
    document.getElementById('ms-refresh')?.classList.toggle('is-loading', on);
    skinBtn()?.classList.toggle('is-loading', on);
  }

  /* ---------- 三个按钮 ---------- */
  // 刷新：同模型重挂（换动作/重新加载）
  document.getElementById('ms-refresh')?.addEventListener('click', () => {
    setLoading(true);
    const skin = currentSkin ?? getSavedSkin();
    ensureLib(() => { mount(skin); setTimeout(() => setLoading(false), 1200); });
  });

  // 换装：轮换到下一个模型
  document.getElementById('ms-skin')?.addEventListener('click', () => {
    setLoading(true);
    const next = MODELS[(skinIndex + 1) % MODELS.length];
    ensureLib(() => { mount(next); setTimeout(() => setLoading(false), 1200); });
  });

  // 显示/隐藏：隐藏时收起画布只留按钮，状态持久化
  document.getElementById('ms-toggle')?.addEventListener('click', () => {
    const w = widget();
    if (!w) return;
    const hidden = w.dataset.mode === 'off';
    w.dataset.mode = hidden ? '2d' : 'off';
    document.getElementById('ms-toggle')!.textContent = hidden ? '–' : '+';
    localStorage.setItem(KEY_MODE, hidden ? '2d' : 'off');
    if (hidden) ensureLib(() => mount(currentSkin ?? getSavedSkin()));
  });

  function getSavedSkin(): string {
    const s = localStorage.getItem(KEY_SKIN);
    return s && MODELS.includes(s) ? s : 'shizuku';
  }

  /* ---------- 初始化 ---------- */
  const w = widget();
  const urlMode = new URLSearchParams(location.search).get('kanban');
  const savedMode = urlMode ?? (localStorage.getItem(KEY_MODE) ?? '2d'); // 默认显示
  currentSkin = getSavedSkin();
  if (w) {
    if (savedMode === 'off') {
      w.dataset.mode = 'off';
      document.getElementById('ms-toggle')!.textContent = '+';
    } else {
      ensureLib(() => mount(currentSkin!));
    }
  }
</script>

<style>
  .model-widget {
    position: fixed;
    left: 8px;
    bottom: 36px; /* 给底部切换按钮留出高度 */
    z-index: 90;
    pointer-events: none; /* 容器不挡点击，只有子元素自己开 */
  }
  .model-stage {
    display: none;
    pointer-events: auto;
  }
  #live2d-container.is-visible,
  #vrm-stage.is-visible {
    display: block;
  }
  /* 缩小模型在页面上的占比：transform 不影响 canvas 内部分辨率，只改显示大小 */
  #live2d-container {
    transform: scale(0.62);
    transform-origin: left bottom;
  }
  .model-widget[data-mode='off'] .model-stage {
    display: none;
  }
  .model-widget[data-mode='2d'] #live2d-container {
    display: block;
  }
  .model-switch {
    position: fixed;
    left: 10px;
    bottom: 8px;
    display: flex;
    gap: 6px;
    pointer-events: auto;
  }
  .ms-btn {
    padding: 3px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--background);
    color: var(--text-soft);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .ms-btn:hover {
    border-color: var(--brand);
    color: var(--text);
  }
  .ms-btn.is-loading {
    animation: ms-pulse 1s ease-in-out infinite;
  }
  @keyframes ms-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }
  @media (max-width: 640px) {
    .model-widget {
      display: none; /* 手机上收起，避免挡内容 */
    }
  }
</style>
