---
import type { Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: Post;
  /** 列表中的序号，用于入场动画错峰 */
  index?: number;
  /** compact = 横向紧凑卡（列表页默认）；feature = 大封面纵向卡（首页） */
  variant?: 'compact' | 'feature';
}
const { post, index = 0, variant = 'compact' } = Astro.props;
const { title, description, pubDate, tags, category, cover, pinned } = post.data;
---

<!-- 没有 cover 就整块不渲染，卡片退成单列、正文占满宽度。
     以前这里有个「标题哈希算色相 + 分类首字水印」的渐变兜底块，已移除：
     绝大多数文章都不配图，那块占掉 200px 却不提供任何信息。 -->
<article
  class:list={['card', 'post-card', `is-${variant}`, cover && 'has-cover']}
  style={`--i:${index};`}
>
  {cover && (
    <a class="cover" href={`/blog/${post.id}/`} aria-hidden="true" tabindex="-1">
      <img src={cover} alt="" loading="lazy" />
    </a>
  )}
  <div class="body">
    <div class="head">
      {pinned && <span class="pinned">置顶</span>}
      <a class="category" href={`/categories/${encodeURIComponent(category)}/`}>{category}</a>
    </div>
    <h3><a href={`/blog/${post.id}/`}>{title}</a></h3>
    <p class="desc">{description}</p>
    <div class="post-meta">
      <FormattedDate date={pubDate} />
      {tags.map((tag) => (
        <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
      ))}
    </div>
  </div>
</article>

<style>
  .post-card {
    display: grid;
    /* 默认单列：没有封面时正文占满整张卡 */
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--brand);
    box-shadow: var(--shadow-lift);
  }
  /* 大卡用磨砂质感与更重的悬浮阴影。
     注意：这里是手写磨砂四条属性，而不是给元素加 base.css 的 .glass 类——
     .glass 自带 box-shadow: var(--shadow-glass) 作为静态值，一旦套上，
     下面 .is-feature:hover 想换成同一个 --shadow-glass 就成了空操作，
     hover 的阴影变化会静默消失。静态阴影由 .card 的 --shadow 提供，
     hover 时才升到 --shadow-glass，这个层次差才是效果本身。
     所以别为“去重”把这里改成 class="... glass"。 */
  .is-feature {
    background: var(--glass-bg);
    border-color: var(--glass-border);
    -webkit-backdrop-filter: blur(var(--blur));
    backdrop-filter: blur(var(--blur));
  }
  .is-feature:hover {
    box-shadow: var(--shadow-glass);
  }

  /* 有封面才切成两列。写成 .post-card.has-cover 而不是单独一个 .has-cover，
     是因为下面 720px 的媒体查询要把它压回单列——那条也必须带上同样的两个类，
     否则单类选择器压不过这里的双类。 */
  .post-card.has-cover {
    grid-template-columns: 200px minmax(0, 1fr);
  }

  .cover {
    display: block;
    position: relative;
    min-height: 150px;
    /* 图加载完成前的占位底色 */
    background: var(--bg-soft);
  }
  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    padding: 20px 22px;
    min-width: 0;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .pinned {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--brand);
    color: var(--brand-ink);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .category {
    color: var(--text-soft);
    font-size: 0.8rem;
  }
  .category:hover {
    color: var(--link);
    text-decoration: none;
  }
  h3 {
    margin: 0 0 6px;
    font-size: 1.18rem;
  }
  h3 a {
    color: var(--text);
  }
  .post-card:hover h3 a {
    color: var(--link);
    text-decoration: none;
  }
  .desc {
    margin: 0 0 12px;
    color: var(--text-soft);
    font-size: 0.93rem;
    /* 最多两行，超出省略 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== feature 变体：大封面纵向卡，仅首页使用 ===== */
  .post-card.is-feature {
    grid-template-columns: minmax(0, 1fr);
  }
  .is-feature .cover {
    /* 固定 16:9，避免不同封面图把卡片撑成不同高度 */
    aspect-ratio: 16 / 9;
    min-height: 0;
  }
  .is-feature .body {
    padding: 22px 24px 24px;
  }
  .is-feature h3 {
    font-size: 1.42rem;
    /* 标题最多一行，超出省略 */
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .is-feature .desc {
    font-size: 0.97rem;
  }

  @media (max-width: 640px) {
    .is-feature h3 {
      font-size: 1.2rem;
    }
    .is-feature .body {
      padding: 18px;
    }
  }

  @media (max-width: 720px) {
    /* 必须写全 .post-card.has-cover：媒体查询不加特异性，
       只写 .post-card 会被上面那条双类选择器压住，窄屏仍是两列。 */
    .post-card.has-cover {
      grid-template-columns: minmax(0, 1fr);
    }
    .cover {
      min-height: 140px;
    }
    .body {
      padding: 18px;
    }
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .is-feature {
      background: var(--card);
      border-color: var(--border);
    }
  }
</style>
