---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import SearchPanel from '../components/SearchPanel.astro';
import ModelWidget from '../components/ModelWidget.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { SITE_TITLE, SITE_DESCRIPTION, HERO_TONE, HERO_IMAGE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** sidebar = 左侧栏 + 内容；toc = 内容 + 右目录；plain = 居中单栏 */
  layout?: 'sidebar' | 'toc' | 'plain';
  /** 分享卡片的图。文章页传自己的封面，其余页面留空用 Hero 兜底 */
  ogImage?: string;
  /** 文章页用 article，其余用 website */
  ogType?: 'website' | 'article';
}
const { title, description, layout = 'plain', ogImage, ogType = 'website' } = Astro.props;
// 有 Hero 的页面：Hero 顶到 y=0，导航转成透明浮层压在图上
const hasHero = Astro.slots.has('hero');
// HERO_TONE 写在 <html> 上而不是 .hero 上：透明导航要用同一套 --hero-* 令牌，
// 而它是 main 的兄弟节点，挂在 .hero 内部继承不到。
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const pageDesc = description ?? SITE_DESCRIPTION;
const canonical = new URL(Astro.url.pathname, Astro.site);
// og:image 必须是绝对地址——微信/Telegram 等抓取方不解析相对路径。
// 没传就从 Hero 图兜底，保证每个页面都有分享缩略图。
const ogImageUrl = new URL(ogImage ?? HERO_IMAGE, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-hero-tone={HERO_TONE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={pageDesc} />
    <meta property="og:locale" content="zh_CN" />
    <!-- Telegram / X / Discord 读 twitter:card；微信读上面的 og:* -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="generator" content={Astro.generator} />
    {/* Hero 图是首页 LCP 元素。浏览器要解析到 <img> 才开始下载，
        这里提前声明，省掉几百毫秒的发现延迟。只在真有 Hero 的页面输出。 */}
    {hasHero && <link rel="preload" as="image" href={HERO_IMAGE} fetchpriority="high" />}
    <!-- 进入页面前先设置主题，避免深浅色闪烁 -->
    <script is:inline>
      // 包一层 IIFE：这是经典脚本（is:inline），顶层 const 会进入全局词法作用域。
      // Twikoo 的 CDN 脚本顶层声明 var e, t —— var 与已存在的全局 let/const 绑定同名
      // 会直接 SyntaxError，整个脚本解析失败、评论区空白。作用域隔离才是根治。
      (function () {
        var theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    {/* 页面级自定义 head 内容（如文章页的 JSON-LD 结构化数据） */}
    <slot name="head" />
  </head>
  <body>
    <Header transparent={hasHero} />
    <main class:list={[hasHero && 'has-hero']}>
      <!-- Hero 在 .page 之外：它要撑满 100vw，留在 max-width:1200px 的容器里
           就得靠负 margin 破格，不如直接放到容器外面 -->
      <slot name="hero" />
      <!-- id 供 Hero 底部的向下箭头锚定；偏移由 base.css 的 scroll-padding-top 统一处理 -->
      <div class="page" id="content">
        <div class={`page-grid layout-${layout}`}>
          {layout === 'sidebar' && <Sidebar />}
          <div class="page-main"><slot /></div>
          {layout === 'toc' && <slot name="toc" />}
        </div>
      </div>
    </main>
    <Footer />
    <SearchPanel />
    <script>
      import '../scripts/card-glow.js';
      import { createDotLoader } from '../scripts/dot-loader.js';
      // CommentsTwikoo 是 is:inline 脚本，无法 import，只能走全局。
      // 只暴露这一个工厂函数，不挂整个模块。
      window.__createDotLoader = createDotLoader;
    </script>
    <ModelWidget />
    <FloatingActions />
  </body>
</html>
