---
import BaseLayout from '../layouts/BaseLayout.astro';
import FriendLinks from '../components/FriendLinks.astro';
import FriendApply from '../components/FriendApply.astro';
import Comments from '../components/Comments.astro';
import PageBlock from '../components/PageBlock.astro';
import { FRIEND_LINKS } from '../consts';

const hasFriends = FRIEND_LINKS.length > 0;
---

<BaseLayout title="友情链接" description="友情链接与朋友们" layout="sidebar">
  <PageBlock variant="wide">
  <h1 class="page-title">友情链接</h1>

  {hasFriends ? (
    <FriendLinks />
  ) : (
    <p class="empty">
      还没有友链。想交换友链的话，先给你的站点加上本站链接，然后通过下面的方式告诉我。
    </p>
  )}

  <FriendApply />
  <Comments />
  </PageBlock>
</BaseLayout>

<style>
  .page-title {
    margin: 0 0 20px;
  }
  .empty {
    color: var(--text-soft);
    line-height: 1.8;
  }
</style>
