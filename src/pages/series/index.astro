---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeries } from '../../lib/posts';

const series = await getSeries();
---

<BaseLayout title="系列" description="系列专栏：围绕一个主题连续写下去" layout="sidebar">
  <h1 class="page-title">系列 <span class="count">{series.length}</span></h1>
  {series.length === 0 && (
    <p class="empty">还没有系列。给文章 frontmatter 加 <code>series: 系列名</code> 就会出现在这里。</p>
  )}
  <div class="grid">
    {series.map((g) => (
      <a class="card serie" href={`/series/${encodeURIComponent(g.name)}/`}>
        <span class="name">{g.name}</span>
        <span class="num">{g.posts.length} 篇 · 最近更新于 {g.posts[g.posts.length - 1]!.data.pubDate.getUTCFullYear()} 年</span>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .count {
    color: var(--text-soft);
    font-size: 1rem;
    font-weight: 400;
  }
  .empty {
    color: var(--text-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }
  .serie {
    padding: 22px;
    color: var(--text);
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .serie:hover {
    transform: translateY(-2px);
    border-color: var(--brand);
    box-shadow: var(--shadow-lift);
    text-decoration: none;
  }
  .name {
    display: block;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 4px;
  }
  .num {
    color: var(--text-soft);
    font-size: 0.85rem;
  }
</style>
