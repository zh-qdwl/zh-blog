---
import BaseLayout from '../layouts/BaseLayout.astro';
import FriendLinks from '../components/FriendLinks.astro';
import FriendApply from '../components/FriendApply.astro';
import ContactCard from '../components/ContactCard.astro';
import Comments from '../components/Comments.astro';
import PageBlock from '../components/PageBlock.astro';
import { AUTHOR, FRIEND_LINKS } from '../consts';
---

<BaseLayout title="关于" description="关于我" layout="plain">
  <PageBlock variant="narrow">
  <article>
    <header class="article-header">
      <h1>关于</h1>
    </header>
    <div class="prose">
      <p>你好，我是 {AUTHOR}。这里是我的个人博客，用来记录编程、技术学习与日常思考。</p>
      <p>这个博客用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建，全站静态、访问飞快。</p>
      <h2>联系我</h2>
      <p>可以在 GitHub 上找到我，或者通过邮件联系。也欢迎去 <a href="/guestbook">留言页</a> 找我。</p>
    </div>

    {/* 友链放在正文之外：它是一块独立的卡片区，不该被 .prose 的段落样式管着 */}
    <section class="friends-section" aria-labelledby="friends-title">
      <h2 id="friends-title" class="section-heading">小伙伴们</h2>
      {FRIEND_LINKS.length > 0 ? (
        <FriendLinks />
      ) : (
        <p class="friends-empty">
          这里还空着。如果你也在写博客，欢迎<a href="#friend-apply-title">交换友链</a>。
        </p>
      )}
      <p class="friends-more">
        <a href="/friends">查看友情链接页 →</a>
      </p>
    </section>

    <FriendApply />

    <ContactCard title="联系我" subject="来自关于页" />
    <Comments />
    </article>
  </PageBlock>
</BaseLayout>

<style>
  .article-header h1 {
    font-size: 2rem;
    margin: 0 0 24px;
  }
  .friends-section {
    margin: 44px 0 0;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .section-heading {
    margin: 0 0 18px;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .friends-empty {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.75;
  }
  .friends-more {
    margin: 18px 0 0;
    font-size: 0.88rem;
  }
</style>
