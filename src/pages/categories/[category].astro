---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getCategories, type Post } from '../../lib/posts';
import { sortPinnedFirst } from '../../lib/posts-core';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = await getCategories();
  return categories.map((c) => ({
    params: { category: c.name },
    // 置顶优先，与首页/全部文章页一致，避免 PostCard 的置顶徽标与实际排序不符
    props: { category: c.name, posts: sortPinnedFirst(posts.filter((p) => p.data.category === c.name)) },
  }));
}

const { category, posts } = Astro.props as { category: string; posts: Post[] };
---

<BaseLayout
  title={`分类：${category}`}
  description={`分类「${category}」下的全部文章`}
  layout="sidebar"
>
  <p class="crumb"><a href="/categories">分类</a> /</p>
  <h1 class="page-title">{category} <span class="count">{posts.length} 篇</span></h1>
  <ul class="post-list">
    {posts.map((post, i) => <li><PostCard post={post} index={i} /></li>)}
  </ul>
</BaseLayout>

<style>
  .count {
    color: var(--text-soft);
    font-size: 1rem;
    font-weight: 400;
  }
</style>
